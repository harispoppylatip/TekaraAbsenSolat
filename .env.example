APP_NAME="Absen Solat SMKIM4"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absen_solat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Mesin pengenal wajah (layanan Python terpisah)
# Ubah FACE_SERVICE_URL bila mesin wajah berjalan di komputer lain.
# FACE_EXPECTED_SECONDS hanya dipakai untuk perkiraan persen kemajuan
# antrean; kecilkan bila mesin wajah memakai kartu grafis.
# ---------------------------------------------------------------
FACE_SERVICE_URL=http://127.0.0.1:5005
FACE_TOLERANCE=0.6
FACE_MODEL=dlib-resnet-v1
FACE_SERVICE_TIMEOUT=90
FACE_EXPECTED_SECONDS=15
FACE_DEVICE_ID=kamera-wajah

# ---------------------------------------------------------------
# Aturan absen solat
# ---------------------------------------------------------------
SOLAT_LATE_MINUTES=10
SOLAT_DEVICE_ID=kamera-wajah

# ---------------------------------------------------------------
# Docker (docker-compose.yml)
#
# Hanya dibaca saat menjalankan "docker compose". Pengembangan di komputer
# dengan "php artisan serve" tidak terpengaruh sebab kunci di sini memakai
# akhiran _DOCKER.
#
# Ganti sandi di bawah sebelum dipakai di jaringan sekolah.
# ---------------------------------------------------------------

# Port web di komputer induk. 8080 dipilih supaya tidak bentrok dengan
# "php artisan serve" (8000) maupun XAMPP atau Laragon (80).
APP_PORT=8080

# Alamat aplikasi yang dilihat pengguna. Ganti dengan alamat IP komputer
# server bila diakses dari komputer lain, mis. http://192.168.1.10:8080.
APP_URL_DOCKER=http://localhost:8080

# Kesan aplikasi di dalam wadah. Isi local dan true bila perlu melihat
# pesan galat terperinci saat memasang pertama kali.
APP_ENV_DOCKER=production
APP_DEBUG_DOCKER=false

# Catatan aplikasi dikirim ke keluaran wadah supaya terbaca lewat
# "docker compose logs". Isi debug bila sedang mencari masalah.
LOG_CHANNEL_DOCKER=stderr
LOG_LEVEL_DOCKER=warning

# Hubungan ke MySQL yang dilihat dari dalam wadah.
#   db                    MySQL bawaan docker-compose (layanan db)
#   host.docker.internal  MySQL yang berjalan di komputer induk
#   192.168.x.x           MySQL yang berjalan di komputer lain
DB_HOST_DOCKER=db
DB_USERNAME_DOCKER=absen_solat
DB_PASSWORD_DOCKER=ubah-sandi-ini
DB_ROOT_PASSWORD=ubah-sandi-root-ini

# Port MySQL bawaan compose untuk diambil dari luar wadah, mis.
#   mysql -h 127.0.0.1 -P 3307 -u absen_solat -p
# Isi DB_PUBLISH_HOST=127.0.0.1 bila basis data hanya perlu diakses dari
# komputer induk sendiri.
DB_PUBLISH_HOST=0.0.0.0
DB_PUBLISH_PORT=3307

# Migrasi jalan sendiri saat wadah app hidup. Aman diulang karena hanya
# menjalankan migrasi yang belum dijalankan.
RUN_MIGRATIONS=true

# Membangun cache konfigurasi, rute, dan tampilan saat wadah app hidup.
# Biarkan mati selama masih sering mengubah isi .env.
# RUN_OPTIMIZE=false

# Alamat mesin wajah yang dilihat dari DALAM wadah. "127.0.0.1" di dalam
# wadah menunjuk wadah itu sendiri, jadi pakai host.docker.internal bila
# mesin wajah berjalan di komputer ini.
FACE_SERVICE_URL_DOCKER=http://host.docker.internal:5005
