APP_NAME="Absen Solat SMKIM4"
APP_ENV=local
APP_KEY=base64:6RNwr94nZ8I3fPjameWysrrcd+dONi7hWiJMELqiKSk=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=absen_solat
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Mesin pengenal wajah (layanan Python terpisah)
# Ubah FACE_SERVICE_URL bila mesin wajah berjalan di komputer lain.
# FACE_EXPECTED_SECONDS hanya dipakai untuk menaksir persentase kemajuan
# queue saat foto di-encode; kecilkan bila mesin wajah memakai GPU.
# ---------------------------------------------------------------
FACE_SERVICE_URL=http://127.0.0.1:5005
FACE_TOLERANCE=0.6
FACE_MODEL=dlib-resnet-v1
FACE_SERVICE_TIMEOUT=90
FACE_EXPECTED_SECONDS=15
FACE_DEVICE_ID=kamera-wajah

# ---------------------------------------------------------------
# Aturan absen solat
#
# SOLAT_EARLY_OPEN_MINUTES  menit sebelum jam mulai saat sesi sudah
#                           boleh dibuka, dipakai petugas maupun mesin
# SOLAT_SESSION_CREATE_TIME jam penjadwal menyiapkan sesi hari itu
# SOLAT_PREPARE_DAYS_AHEAD  berapa hari sesudah hari ini ikut disiapkan
# ---------------------------------------------------------------
SOLAT_LATE_MINUTES=10
SOLAT_DEVICE_ID=kamera-wajah
SOLAT_EARLY_OPEN_MINUTES=10
SOLAT_SESSION_CREATE_TIME=00:05
SOLAT_PREPARE_DAYS_AHEAD=1

# ---------------------------------------------------------------
# Bukti foto absen wajah
#
# SOLAT_KEEP_PROOF_PHOTO      simpan potret kecil setiap absen wajah
#                             sebagai bukti di halaman riwayat
# SOLAT_PROOF_MAX_BYTES       batas ukuran berkas bukti yang diterima
#                             dari mesin wajah, dalam bita
# SOLAT_PROOF_RETENTION_DAYS  umur simpan bukti sebelum dibersihkan
#                             penjadwal; isi 0 supaya disimpan terus
# ---------------------------------------------------------------
SOLAT_KEEP_PROOF_PHOTO=true
SOLAT_PROOF_MAX_BYTES=262144
SOLAT_PROOF_RETENTION_DAYS=90

# ---------------------------------------------------------------
# Docker (docker-compose.yml)
#
# Hanya dibaca saat menjalankan "docker compose". Pengembangan dengan
# "php artisan serve" tidak terpengaruh karena kunci di sini memakai
# akhiran _DOCKER.
#
# Ganti password di bawah sebelum dipakai di jaringan sekolah.
# ---------------------------------------------------------------

# Port web di komputer host. 8080 dipilih supaya tidak bentrok dengan
# "php artisan serve" (8000) maupun XAMPP atau Laragon (80).
# Bila aplikasi dibuka lewat domain bersertifikat, tulis
# 127.0.0.1:8080 supaya port ini hanya bisa dibuka dari komputer server
# sendiri, dan pengguna masuk lewat proxy pemegang sertifikat.
APP_PORT=8080

# Alamat aplikasi yang dilihat pengguna. Ganti dengan alamat IP komputer
# server bila diakses dari komputer lain, mis. http://192.168.1.10:8080.
# Bila memakai domain bersertifikat, isi alamat https-nya, mis.
# https://absen.namasekolah.sch.id, dan pastikan proxy pemegang sertifikat
# sudah mengirim header X-Forwarded-Proto seperti dijelaskan pada
# README-docker.md bagian "Memakai domain dan HTTPS".
APP_URL_DOCKER=http://localhost:8080

# Lingkungan aplikasi (APP_ENV) di dalam container. Isi local dan true
# bila perlu melihat pesan error terperinci saat pemasangan pertama.
APP_ENV_DOCKER=production
APP_DEBUG_DOCKER=false

# Log aplikasi dikirim ke output container supaya terbaca lewat
# "docker compose logs". Isi debug bila sedang mencari masalah.
LOG_CHANNEL_DOCKER=stderr
LOG_LEVEL_DOCKER=warning

# Koneksi ke MySQL yang dilihat dari dalam container.
#   db                    MySQL bawaan docker-compose (layanan db)
#   host.docker.internal  MySQL yang berjalan di komputer host
#   192.168.x.x           MySQL yang berjalan di komputer lain
DB_HOST_DOCKER=db
DB_USERNAME_DOCKER=absen_solat
DB_PASSWORD_DOCKER=AbsenSolat2026
DB_ROOT_PASSWORD=RootAbsenSolat2026

# Port MySQL bawaan compose untuk diakses dari luar container, mis.
#   mysql -h 127.0.0.1 -P 3307 -u absen_solat -p
# Isi DB_PUBLISH_HOST=127.0.0.1 bila database hanya perlu diakses dari
# komputer host sendiri.
DB_PUBLISH_HOST=0.0.0.0
DB_PUBLISH_PORT=3307

# Migrasi jalan sendiri saat container app hidup. Aman diulang karena
# hanya menjalankan migrasi yang belum dijalankan.
RUN_MIGRATIONS=true

# Membangun cache konfigurasi, route, dan view saat container app hidup.
# Biarkan mati selama masih sering mengubah isi .env.
# RUN_OPTIMIZE=false

# Alamat mesin wajah yang dilihat dari DALAM container.
#   host.docker.internal  mesin wajah berjalan di komputer ini
#   192.168.x.x           mesin wajah berjalan di komputer lain
# "127.0.0.1" di dalam container menunjuk container itu sendiri, jadi
# jangan dipakai di sini.
FACE_SERVICE_URL_DOCKER=http://host.docker.internal:5005
