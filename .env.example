# ===========================================================================
# CARA MEMAKAI BERKAS INI
#
#   Bagian atas (sampai bagian "Docker") dipakai bila aplikasi dijalankan
#   langsung di komputer ini dengan "php artisan serve" atau "composer dev".
#
#   Bagian "Docker" di bawah dipakai bila aplikasi dijalankan dengan
#   "docker compose". Semua kunci di sana berakhiran _DOCKER supaya tidak
#   bentrok dengan bagian atas, jadi keduanya bisa hidup berdampingan.
#
#   Mulai dengan menyalin berkas ini: copy .env.example .env
#   Lalu isi hanya bagian yang sesuai dengan cara menjalankan Anda.
# ===========================================================================

APP_NAME="Absen Solat SMKIM4"
APP_ENV=local
APP_KEY=base64:6RNwr94nZ8I3fPjameWysrrcd+dONi7hWiJMELqiKSk=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database untuk dijalankan TANPA Docker
#
# Lima baris di bawah sedang dimatikan dengan tanda # karena database
# dibaca dari bagian Docker. Bila Anda menjalankan aplikasi langsung
# dengan "php artisan serve", hapus tanda # pada kelimanya lebih dulu.
#
# Kalau dibiarkan mati, Laravel diam-diam memakai SQLite sehingga aplikasi
# berbunyi "no such table" walau MySQL sudah benar.
#
# DB_DATABASE juga dibaca oleh docker-compose.yml untuk menentukan nama
# database, jadi pastikan namanya sama dengan yang ada di MySQL.
# ---------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=absen_solat
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Mesin pengenal wajah (layanan Python terpisah)
#
# FACE_SERVICE_URL adalah alamat mesin wajah bila dijalankan TANPA Docker.
# Isi alamat yang benar:
#   http://127.0.0.1:5005     mesin wajah ada di komputer ini
#   http://192.168.1.60:5005  mesin wajah ada di komputer lain
# Alamat untuk Docker ada di FACE_SERVICE_URL_DOCKER, di bagian paling
# bawah berkas ini.
#
# FACE_EXPECTED_SECONDS tidak mengubah proses apa pun. Nilainya hanya
# dipakai untuk menaksir persentase kemajuan antrean unggahan, jadi
# kecilkan bila mesin wajah memakai kartu grafis.
# ---------------------------------------------------------------
FACE_SERVICE_URL=http://127.0.0.1:5005
FACE_TOLERANCE=0.6
FACE_MODEL=dlib-resnet-v1
FACE_SERVICE_TIMEOUT=90
FACE_EXPECTED_SECONDS=15
FACE_DEVICE_ID=kamera-wajah

# ---------------------------------------------------------------
# Aturan absen solat
# ---------------------------------------------------------------
SOLAT_LATE_MINUTES=10
SOLAT_DEVICE_ID=kamera-wajah

# ===========================================================================
# DOCKER (dibaca oleh docker-compose.yml)
#
# Seluruh kunci di bagian ini hanya berlaku saat menjalankan
# "docker compose". Menjalankan dengan "php artisan serve" tidak
# terpengaruh sama sekali karena kuncinya berakhiran _DOCKER.
#
# Ganti sandi di bawah sebelum dipakai di jaringan sekolah.
# ===========================================================================

# Port web di komputer host. 8080 dipilih supaya tidak bentrok dengan
# "php artisan serve" (8000) maupun XAMPP atau Laragon (80).
APP_PORT=8080

# Alamat aplikasi yang dilihat pengguna. Ganti dengan alamat IP komputer
# server bila diakses dari komputer lain, mis. http://192.168.1.10:8080.
APP_URL_DOCKER=http://localhost:8080

# Lingkungan aplikasi (APP_ENV) di dalam container. Isi local dan true
# bila perlu melihat pesan error terperinci saat pemasangan pertama.
APP_ENV_DOCKER=production
APP_DEBUG_DOCKER=false

# Log aplikasi dikirim ke output container supaya terbaca lewat
# "docker compose logs". Isi debug bila sedang mencari masalah.
LOG_CHANNEL_DOCKER=stderr
LOG_LEVEL_DOCKER=warning

# ---------------------------------------------------------------------------
# Database yang dilihat DARI DALAM container
#
# Pilih SATU dari tiga kemungkinan berikut, lalu isi tiga kunci di bawahnya
# sesuai pilihan itu. Hanya satu yang dipakai.
#
# PILIHAN A. MySQL ikut nyala di dalam Docker
#   DB_HOST_DOCKER=db
#   Akun dan database dibuat otomatis dari tiga kunci di bawah.
#   Jalankan: docker compose up -d --build
#
# PILIHAN B. MySQL ada di komputer yang sama dengan Docker
#   DB_HOST_DOCKER=host.docker.internal
#   Akun dan database harus sudah dibuat sendiri di MySQL komputer ini.
#   Jalankan: docker compose up -d --build app web queue scheduler
#
# PILIHAN C. MySQL ada di komputer lain, misalnya server khusus database
#   DB_HOST_DOCKER=192.168.1.50
#   Akun dan database harus sudah dibuat sendiri di MySQL komputer itu.
#   Jalankan: docker compose up -d --build app web queue scheduler
#
# Tiga hal yang sering menyesatkan pada Pilihan B dan C:
#   1. Nama akun harus boleh masuk dari jaringan Docker. Akun
#      'root'@'localhost' tidak diterima. Gejalanya berbunyi
#      "Access denied for user ...@'172.x.x.x'" (alamat, bukan sandi).
#   2. bind-address MySQL di komputer itu wajib 0.0.0.0, bukan 127.0.0.1.
#      Gejalanya berbunyi "Connection refused".
#   3. DB_ROOT_PASSWORD tidak dipakai, tetapi tetap wajib terisi karena
#      docker-compose.yml membacanya lebih dulu. Isi apa saja.
#
# Port MySQL dipatok 3306 langsung di docker-compose.yml, jadi DB_PORT di
# bagian atas berkas ini tidak berpengaruh terhadap Docker.
# ---------------------------------------------------------------------------
DB_HOST_DOCKER=db
DB_USERNAME_DOCKER=absen_solat
DB_PASSWORD_DOCKER=AbsenSolat2026
DB_ROOT_PASSWORD=RootAbsenSolat2026

# Port MySQL ini hanya berlaku untuk PILIHAN A, yaitu saat MySQL nyala di
# dalam Docker. Tujuannya supaya database itu bisa dibuka dari luar, mis.
#   mysql -h 127.0.0.1 -P 3307 -u absen_solat -p
# Untuk Pilihan B dan C dua kunci ini tidak berpengaruh, sebab MySQL yang
# dipakai bukan milik Docker.
#
# Isi DB_PUBLISH_HOST=127.0.0.1 bila database hanya perlu diakses dari
# komputer ini sendiri, bukan dari jaringan.
DB_PUBLISH_HOST=0.0.0.0
DB_PUBLISH_PORT=3307

# Migrasi jalan sendiri saat container app hidup. Aman diulang karena
# hanya menjalankan migrasi yang belum dijalankan.
RUN_MIGRATIONS=true

# Membangun cache konfigurasi, route, dan view saat container app hidup.
# Biarkan mati selama masih sering mengubah isi .env.
# RUN_OPTIMIZE=false

# Alamat mesin wajah yang dilihat dari DALAM container.
#   host.docker.internal  mesin wajah berjalan di komputer ini
#   192.168.1.60          mesin wajah berjalan di komputer lain
# "127.0.0.1" di dalam container menunjuk container itu sendiri, jadi
# jangan dipakai di sini.
#
# Mesin wajah di komputer lain juga wajib mendengarkan 0.0.0.0 dan port
# 5005 dibuka di firewall komputer itu, kalau tidak container akan gagal
# menyambung.
#
# Alamat untuk dijalankan TANPA Docker ada di FACE_SERVICE_URL, di bagian
# atas berkas ini.
FACE_SERVICE_URL_DOCKER=http://host.docker.internal:5005
