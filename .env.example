# ---------------------------------------------------------------
# Mesin pengenal wajah (layanan Python terpisah: instighface/absen-solat)
# Ubah FACE_SERVICE_URL bila mesin wajah berjalan di komputer lain.
#
# Mesin yang dipakai sekarang adalah InsightFace dengan model buffalo_sc,
# yang menghasilkan 512 angka per wajah dan menormalkannya sehingga jarak
# di bawah ini setara dengan cosine similarity.
#
# FACE_MODEL  WAJIB sama dengan FACE_MODEL_NAME di berkas .env layanan wajah.
#             Bila berbeda, seluruh sidik wajah yang tersimpan dilewati.
# FACE_EXPECTED_SECONDS hanya dipakai untuk menaksir persentase kemajuan
#             queue saat foto di-encode; model ini butuh sekitar 0,04 detik
#             per foto di mesin tanpa kartu grafis.
#
# Ambang pencocokan wajah:
# FACE_TOLERANCE              jarak terjauh yang masih diterima sebagai
#                             anggota yang sama, kecil berarti lebih ketat.
#                             1,15 dipilih dari pengukuran foto sungguhan
#                             (celah aman terukur 1,1427 sampai 1,1650)
# FACE_AGGREGATE_PHOTOS       berapa jarak foto terdekat yang dirata-ratakan
#                             saat menilai satu anggota, bawaan 2
# FACE_SINGLE_PHOTO_TOLERANCE jarak wajib bagi anggota yang fotonya kurang
#                             dari angka di atas, harus lebih ketat
# FACE_MIN_MARGIN             selisih minimal juara pertama dan kedua,
#                             di bawah angka ini hasilnya dilaporkan ambigu
# FACE_MIN_FACE_SIZE          sisi wajah paling kecil dalam piksel yang
#                             boleh diputuskan, isi 0 untuk mematikan
# FACE_ENFORCE_MODEL          lewati angka wajah yang modelnya berbeda
# ---------------------------------------------------------------
FACE_SERVICE_URL=http://127.0.0.1:5005
FACE_TOLERANCE=1.15
FACE_AGGREGATE_PHOTOS=2
FACE_SINGLE_PHOTO_TOLERANCE=1.04
FACE_MIN_MARGIN=0.14
FACE_MIN_FACE_SIZE=80
FACE_ENFORCE_MODEL=true
FACE_MODEL=insightface-buffalo_sc
FACE_SERVICE_TIMEOUT=30
FACE_EXPECTED_SECONDS=2
FACE_DEVICE_ID=kamera-wajah

# ---------------------------------------------------------------
# Pendaftaran wajah mandiri oleh pemilik akun (/pendaftaran-wajah)
#
# FACE_ENROLLMENT_REQUIRED_PHOTOS  foto yang wajib terkumpul sebelum
#                                  pendaftaran bisa diselesaikan
# FACE_ENROLLMENT_MAX_PHOTOS       foto terbanyak satu anggota, tidak boleh
#                                  melebihi batas 20 foto per anggota
# FACE_ENROLLMENT_PER_SUBMIT       foto terbanyak sekali kirim
# FACE_DUPLICATE_TOLERANCE         jarak maksimal yang masih dianggap foto
#                                  kembar, isi 0 untuk mematikan. Diukur dari
#                                  34 foto lima orang: pasangan kembar 0,2137
#                                  sampai 0,3567, sedangkan orang sama dengan
#                                  sudut berbeda 0,4998 ke atas
# ---------------------------------------------------------------
FACE_ENROLLMENT_REQUIRED_PHOTOS=5
FACE_ENROLLMENT_MAX_PHOTOS=10
FACE_ENROLLMENT_PER_SUBMIT=3
FACE_DUPLICATE_TOLERANCE=0.38

# ---------------------------------------------------------------
# Pemeriksaan mutu foto di layanan wajah (khusus pendaftaran)
#
# Pemeriksaan ini HANYA dijalankan bila halaman pendaftaran memintanya,
# sehingga alur absen di gerbang tidak ikut berubah saat ambang ini disetel.
# Seluruh angkanya diukur dari 34 foto sungguhan lima orang. Kecerahan dan
# ketajaman pada wajah yang sah terukur 64,98 sampai 165,91 dan 37,37 sampai
# 1108,66, sedangkan sudut hadapnya 0,0025 sampai 1,2655. Ambang di bawah ini
# sengaja diletakkan di LUAR sebaran itu supaya foto yang sah tidak ikut
# ditolak. Kuncinya dibaca oleh layanan wajah, bukan oleh aplikasi ini.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Aturan absen solat
#
# SOLAT_EARLY_OPEN_MINUTES  menit sebelum jam mulai saat sesi sudah
#                           boleh dibuka, dipakai petugas maupun mesin
# SOLAT_SESSION_CREATE_TIME jam penjadwal menyiapkan sesi hari itu
# SOLAT_PREPARE_DAYS_AHEAD  berapa hari sesudah hari ini ikut disiapkan
# SOLAT_TEST_COOLDOWN_MINUTES  jeda sebelum orang yang sama boleh
#                           tercatat lagi pada mode uji coba; isi 0
#                           supaya jedanya dimatikan
# ---------------------------------------------------------------
SOLAT_LATE_MINUTES=10
SOLAT_DEVICE_ID=kamera-wajah
SOLAT_EARLY_OPEN_MINUTES=10
SOLAT_SESSION_CREATE_TIME=00:05
SOLAT_PREPARE_DAYS_AHEAD=1
SOLAT_TEST_COOLDOWN_MINUTES=4

# ---------------------------------------------------------------
# Bukti foto absen wajah
#
# SOLAT_KEEP_PROOF_PHOTO      simpan potret kecil setiap absen wajah
#                             sebagai bukti di halaman riwayat
# SOLAT_PROOF_MAX_BYTES       batas ukuran berkas bukti yang diterima
#                             dari mesin wajah, dalam bita
# SOLAT_PROOF_RETENTION_DAYS  umur simpan bukti sebelum dibersihkan
#                             penjadwal; isi 0 supaya disimpan terus
# ---------------------------------------------------------------
SOLAT_KEEP_PROOF_PHOTO=true
SOLAT_PROOF_MAX_BYTES=262144
SOLAT_PROOF_RETENTION_DAYS=90

# ---------------------------------------------------------------
# Mesin absen sidik jari IoT (ESP32 + AS608 via HTTP REST API)
#
# Mode kedua absen untuk anggota yang dipilih dan didaftarkan jarinya
# oleh admin di halaman Data Sidik Jari (/sidik-jari).
#
# FINGERPRINT_API_MODE        mode alamat API aktif: offline atau online
# FINGERPRINT_API_URL_OFFLINE alamat API saat jaringan lokal / offline
# FINGERPRINT_API_URL_ONLINE  alamat API saat server online (domain publik)
# FINGERPRINT_COMMAND_TTL     masa berlaku perintah rekam jari di cache (detik)
# ---------------------------------------------------------------
FINGERPRINT_API_MODE=offline
FINGERPRINT_API_URL_OFFLINE=http://localhost:8000/api/fingerprint
FINGERPRINT_API_URL_ONLINE=https://absenmu.tekara.my.id/api/fingerprint
FINGERPRINT_COMMAND_TTL=120

# ---------------------------------------------------------------
# Docker (docker-compose.yml)
#
# Hanya dibaca saat menjalankan "docker compose". Pengembangan dengan
# "php artisan serve" tidak terpengaruh karena kunci di sini memakai
# akhiran _DOCKER.
#
# Ganti password di bawah sebelum dipakai di jaringan sekolah.
# ---------------------------------------------------------------

# Port web di komputer host. 8080 dipilih supaya tidak bentrok dengan
# "php artisan serve" (8000) maupun XAMPP atau Laragon (80).
# Bila aplikasi dibuka lewat domain bersertifikat, tulis
# 127.0.0.1:8080 supaya port ini hanya bisa dibuka dari komputer server
# sendiri, dan pengguna masuk lewat proxy pemegang sertifikat.
APP_PORT=8080

# Alamat aplikasi yang dilihat pengguna. Ganti dengan alamat IP komputer
# server bila diakses dari komputer lain, mis. http://192.168.1.10:8080.
# Bila memakai domain bersertifikat, isi alamat https-nya, mis.
# https://absen.namasekolah.sch.id, dan pastikan proxy pemegang sertifikat
# sudah mengirim header X-Forwarded-Proto seperti dijelaskan pada
# README-docker.md bagian "Memakai domain dan HTTPS".
APP_URL_DOCKER=http://localhost:8080

# Lingkungan aplikasi (APP_ENV) di dalam container. Isi local dan true
# bila perlu melihat pesan error terperinci saat pemasangan pertama.
APP_ENV_DOCKER=production
APP_DEBUG_DOCKER=false

# Log aplikasi dikirim ke output container supaya terbaca lewat
# "docker compose logs". Isi debug bila sedang mencari masalah.
LOG_CHANNEL_DOCKER=stderr
LOG_LEVEL_DOCKER=warning

# Koneksi ke MySQL yang dilihat dari dalam container.
#   db                    MySQL bawaan docker-compose (layanan db)
#   host.docker.internal  MySQL yang berjalan di komputer host
#   192.168.x.x           MySQL yang berjalan di komputer lain
DB_HOST_DOCKER=db
DB_USERNAME_DOCKER=absen_solat
DB_PASSWORD_DOCKER=AbsenSolat2026
DB_ROOT_PASSWORD=RootAbsenSolat2026

# Port MySQL bawaan compose untuk diakses dari luar container, mis.
#   mysql -h 127.0.0.1 -P 3307 -u absen_solat -p
# Isi DB_PUBLISH_HOST=127.0.0.1 bila database hanya perlu diakses dari
# komputer host sendiri.
DB_PUBLISH_HOST=0.0.0.0
DB_PUBLISH_PORT=3307

# Migrasi jalan sendiri saat container app hidup. Aman diulang karena
# hanya menjalankan migrasi yang belum dijalankan.
RUN_MIGRATIONS=true

# Membangun cache konfigurasi, route, dan view saat container app hidup.
# Biarkan mati selama masih sering mengubah isi .env.
# RUN_OPTIMIZE=false

# Alamat mesin wajah yang dilihat dari DALAM container.
#   http://wajah:5005             mesin wajah juga berjalan sebagai container,
#                                 tersambung ke jaringan bersama absen-jaringan
#                                 (bawaan, cara paling pasti)
#   http://host.docker.internal:5005
#                                 mesin wajah berjalan langsung di komputer
#                                 ini, dan FACE_HOST-nya wajib 0.0.0.0
#   192.168.x.x                   mesin wajah berjalan di komputer lain
# "127.0.0.1" di dalam container menunjuk container itu sendiri, jadi
# jangan dipakai di sini.
#
# Jaringan itu dibuat sekali sebelum menjalankan compose:
#     docker network create absen-jaringan
FACE_SERVICE_URL_DOCKER=http://wajah:5005
